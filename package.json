{
  "name": "hyperframes-app-promo-template",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node -e \"const fs=require('fs'); if(fs.existsSync('scenes.json')) fs.writeFileSync('scenes.js', 'window.SCENES_DATA = ' + fs.readFileSync('scenes.json', 'utf8') + ';');\"",
    "predev": "npm run sync",
    "dev": "npx --yes hyperframes@0.8.208 preview",
    "check": "npm run sync && npx --yes hyperframes@0.8.208 check",
    "prerender": "npm run sync",
    "render": "npx --yes hyperframes@0.8.208 render -o output.mp4",
    "render:hq": "npx --yes hyperframes@0.8.208 render -q delivery -o output_hq.mp4",
    "snapshot": "npm run sync && npx --yes hyperframes@0.8.208 snapshot --at 1,3,5"
  }
}
